{
  "name": "little-star-story-house",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "tsc -b && vite build",
    "build:go": "npm run build && node scripts/build-go.mjs",
    "build:go:linux": "npm run build && node scripts/build-go.mjs --target linux-amd64",
    "audio:manifest": "node scripts/generate-audio-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:go:all": "npm run build && node scripts/build-go.mjs --all"
  },
  "dependencies": {
    "framer-motion": "^11.3.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
